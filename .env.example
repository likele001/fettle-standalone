# ============================================
# Fettle AI Agent Platform - 环境变量配置模板
# 复制为 .env 后填入实际值
# ============================================

# ---- 应用基础配置 ----
APP_ENV=production
APP_NAME=fettle
APP_VERSION=1.0.0
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE_HOURS=72

# ---- PostgreSQL 数据库 ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_platform
DB_PASSWORD=your_db_password
DB_NAME=ai_platform
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFE_MINUTES=60

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

# ---- MongoDB (日志/会话存储) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_platform_logs
MONGO_USER=
MONGO_PASSWORD=

# ---- Milvus 向量数据库 ----
# 原生安装可参考 scripts/install_minio_nats_milvus.sh
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=long_term_memory
MILVUS_EMBEDDING_DIM=1536

# ---- MinIO 对象存储 ----
# 原生安装可参考 scripts/install_minio_nats_milvus.sh
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=ai-platform
MINIO_USE_SSL=false

# ---- NATS 消息队列 ----
# 原生安装可参考 scripts/install_minio_nats_milvus.sh
NATS_URL=nats://localhost:4222
NATS_CLUSTER=fettle

# ---- AI 模型配置 ----
# 通义千问
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 兼容接口（通用）
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# ---- 短信服务 (验证码) ----
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=your_sms_access_key
SMS_ACCESS_KEY_SECRET=your_sms_secret
SMS_SIGN_NAME=你的签名
SMS_TEMPLATE_CODE=SMS_123456

# ---- 微信开放平台 ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=

# ---- 服务端口 ----
GATEWAY_PORT=20001
USER_SERVICE_PORT=20002
AGENT_SERVICE_PORT=20003
CHAT_SERVICE_PORT=20004
SKILL_SERVICE_PORT=20005
BILLING_SERVICE_PORT=20006
AI_ENGINE_PORT=20007
WEB_ADMIN_PORT=20009
WEB_PLATFORM_PORT=9801

# ---- 日志 ----
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:20009,http://localhost:9801
