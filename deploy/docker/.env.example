# ============================================================
# Fettle 独立版 (fettle-standalone) — Docker 部署配置模板
# ============================================================
#
# 使用方式：
#   cp .env.example .env
#   # 生成随机密钥（推荐，避免用示例值上线）
#   ./gen-env.sh
#   # 或手动填写下列「必填」项
#   docker compose up -d
#
# 变量分三类：
#   [必填] 缺失会导致 compose 直接报错退出
#   [按需] 用到对应功能时才需填
#   [默认] 已有合理默认值，通常不用改
# ============================================================


# ------------------------------------------------------------
# 1. [必填] 安全密钥
#    建议用 ./gen-env.sh 自动生成，不要用示例值上线
# ------------------------------------------------------------

# JWT 签名密钥，至少 32 字符随机串
JWT_SECRET=

# PostgreSQL 密码
POSTGRES_PASSWORD=


# ------------------------------------------------------------
# 2. [默认] PostgreSQL 配置
#    容器内连接，通常不用改
# ------------------------------------------------------------

POSTGRES_USER=standalone
POSTGRES_DB=standalone


# ------------------------------------------------------------
# 3. [必填] MinIO 对象存储凭据
#    用于文件上传（skill-service / agent-service）
# ------------------------------------------------------------

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=


# ------------------------------------------------------------
# 4. [默认] 中间件地址
#    容器内通过服务名互访，通常不用改
#    若要复用外部的 NATS / MinIO，改成对应地址即可
# ------------------------------------------------------------

NATS_URL=nats://nats:4222
MINIO_ENDPOINT=minio:9000
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530


# ------------------------------------------------------------
# 5. [按需] AI 模型供应商
#    用到 AI 对话/生成功能时必须填至少一个
# ------------------------------------------------------------

# 通义千问（阿里云百炼）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# ------------------------------------------------------------
# 6. [按需] 微信开放平台
#    用到微信登录/公众号时填
# ------------------------------------------------------------

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=


# ------------------------------------------------------------
# 7. [默认] 应用运营参数
# ------------------------------------------------------------

APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# 允许跨域的来源，多个用逗号分隔
# 例：https://ai.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:20009


# ------------------------------------------------------------
# 8. [默认] NATS JetStream 开关
#    false（默认）：核心 NATS，at-most-once，行为与当前生产一致
#    true：消息持久化，可重放，但需额外磁盘
# ------------------------------------------------------------

NATS_JETSTREAM=false
