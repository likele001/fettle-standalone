# 开发环境配置

# API 网关地址（Vite Proxy 会代理 /api 请求到此地址）
VITE_API_BASE_URL=http://localhost:20001

# WebSocket 地址（用于消息推送、实时对话）
VITE_WS_URL=ws://localhost:20001/ws

# 应用标题
VITE_APP_TITLE=AI智能体管理平台

# 应用版本
VITE_APP_VERSION=1.0.0

# 是否开启 Mock（开发调试用）
VITE_USE_MOCK=false

# 文件上传大小限制 (MB)
VITE_UPLOAD_MAX_SIZE=10

# 分页默认条数
VITE_PAGE_SIZE=20

# 验证码开关
VITE_ENABLE_CAPTCHA=true

# 微信登录开关
VITE_ENABLE_WECHAT_LOGIN=false

# 日志级别 (debug | info | warn | error)
VITE_LOG_LEVEL=debug

# 请求超时时间 (ms)
VITE_REQUEST_TIMEOUT=30000

# 是否开启性能监控
VITE_ENABLE_PERFORMANCE=false
