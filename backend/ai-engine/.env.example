# AI Engine 环境变量

# 应用配置
APP_ENV=development
APP_HTTP_PORT=20007
APP_GRPC_PORT=20008
DEBUG=true

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_platform
DB_PASSWORD=CHANGE_ME
DB_NAME=ai_platform

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530

# NATS 配置
NATS_URL=nats://localhost:4222

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 模型配置
DEFAULT_MODEL=qwen-plus
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=3

# API 密钥（生产环境必须设置）
OPENAI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# 嵌入模型配置
EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMENSION=1536

# RAG 配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
